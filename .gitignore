# =====================================================
# TradeSimple - .gitignore
# =====================================================

# =====================================================
# 🔐 민감한 정보 (절대 커밋하면 안 됨!)
# =====================================================
.env
.env.local
.env.*.local
*.pem
*.key
credentials.json
secrets.json

# =====================================================
# Python
# =====================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environment
venv/
.venv/
env/
ENV/
.conda/

# =====================================================
# IDE / 에디터
# =====================================================
.idea/
.vscode/
*.swp
*.swo
*.sublime-workspace
*.sublime-project
.spyderproject
.spyproject
.ropeproject

# =====================================================
# 생성된 파일 (런타임에 생성됨)
# =====================================================
# 보고서 파일 (품목명_HS코드_번호.pdf 등)
report.pdf
report.docx
report.xlsx
report_*.pdf
report_*.docx
report_*.xlsx
*_*_*.pdf
*_*_*.docx
*_*_*.xlsx
reports/

# 로그 파일
*.log
logs/

# =====================================================
# 캐시 및 임시 파일
# =====================================================
.cache/
*.cache
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.hypothesis/

# =====================================================
# OS 관련
# =====================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# =====================================================
# Docker (선택적)
# =====================================================
# Docker 볼륨 데이터는 제외하되 설정 파일은 포함
# Dockerfile, docker-compose.yml은 커밋함

# =====================================================
# 대용량 파일 (선택적)
# =====================================================
# 벡터 스토어 (대용량 파일)
vector_store/

# 폰트 파일 (용량이 클 경우)
# fonts/

# =====================================================
# Jupyter Notebook
# =====================================================
.ipynb_checkpoints/
*.ipynb_checkpoints

# =====================================================
# 테스트
# =====================================================
.pytest_cache/
test_output/
